# Local video downloads (multi-GB)
videos/*
!videos/.gitkeep

# FAA handbook PDFs are large (AFH ~260MB exceeds GitHub’s 100MB file limit).
# Download locally with: python3 scripts/download_faa_handbooks.py
# Official free copies: see study/faa-handbooks/SOURCES.md and README.
study/faa-handbooks/*.pdf

